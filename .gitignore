my-docs/
poc/
official-docs/
docs-almost/

# docs/ holds the documentation site source and is deployed by
# .github/workflows/deploy-docs.yml, so it must stay tracked.
# docs/.gitignore excludes the build output (dist/, .cache/).

*.png
*.txt
*.svg
!example-output.svg
# brand/ holds the master brand assets, so exports there stay tracked.
!brand/**/*.svg
!brand/**/*.png
# Site assets are content, not build artifacts, so they override *.svg above.
!docs/**/*.svg
*.log

*-output.md

# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Generated demo output
cmd/demo/output.html

# Editor/IDE
# .idea/
# .vscode/

# Fixture generator dependencies
tools/genfixtures/node_modules/

# Cloned sample sources (no longer used — now a git submodule as grammars-themes/)
# textmate-grammars-themes/

# CI-only fixture directories (generated on-the-fly, not committed)
internal/fidelity/testdata/golden-full/
internal/fidelity/testdata/golden-theme-stress/
internal/fidelity/testdata/golden-all/
